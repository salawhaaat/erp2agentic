          "x": 600,
          "y": 300
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 5,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": 11537819
              },
              "mapper": {
                "mode": "map",
                "values": {
                  "0": "LAB3_01",
                  "1": "{{1.`0`}}",
                  "2": "{{1.`1`}}",
                  "3": "",
                  "4": "",
                  "5": "STAFF_ESCALATION",
                  "6": "Customer reply could not be applied safely (no matching offer, expired offer, unrecognised choice, or instruction-like text). Owner: shift lead.",
                  "7": "",
                  "8": "",
                  "9": "lab3-agent-v7",
                  "10": "{{now}}",
                  "15": "D",
                  "19": "STAFF_REVIEW"
                },
                "sheetId": "AutoActions",
                "spreadsheetId": "1chr9ntqh-wlb9ISlzznErcPFoL6J1Jox-j0NSWImkP0",
                "tableFirstRow": "A1:Z1",
                "insertDataOption": "INSERT_ROWS",
                "valueInputOption": "USER_ENTERED",
                "insertUnformatted": false
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -300,
                  "name": "Reply to staff"
                }
              },
              "filter": {
                "name": "STAFF - no valid offer, expired, odd text, or swap item no longer in stock",
                "conditions": [
                  [
                    {
                      "a": "{{2.`1`}}",
                      "o": "notexist"
                    }
                  ],
                  [
                    {
                      "a": "{{now}}",
                      "o": "date:greater",
                      "b": "{{2.`17`}}"
                    }
                  ],
                  [
                    {
                      "a": "{{1.`5`}}",
                      "o": "text:pattern:ci",
                      "b": "(ignore|disregard|override|always (approve|choose|refund)|refund me|system prompt|instruction)"
                    }
                  ],
                  [
                    {
                      "a": "{{1.`3`}}",
                      "o": "text:notpattern",
                      "b": "^(ACCEPT_SWAP|WAIT_RESTOCK|DECLINE|NO_REPLY)$"
                    }
                  ],
                  [
                    {
                      "a": "{{1.`3`}}",
                      "o": "text:equal",
                      "b": "ACCEPT_SWAP"
                    },
                    {
                      "a": "{{2.`16`}}",
                      "o": "text:notpattern",
                      "b": "SWAP|BOTH"
                    }
                  ],
                  [
                    {
                      "a": "{{1.`3`}}",
                      "o": "text:equal",
                      "b": "WAIT_RESTOCK"
                    },
                    {
                      "a": "{{2.`16`}}",
                      "o": "text:notpattern",
                      "b": "BOTH"
                    }
                  ],
                  [
                    {
                      "a": "{{1.`3`}}",
                      "o": "text:equal",
                      "b": "ACCEPT_SWAP"
                    },
                    {
                      "a": "{{1.`8`}}",
                      "o": "number:notequal",
                      "b": "1"
                    }
                  ]
                ]
              }
            },
            {
